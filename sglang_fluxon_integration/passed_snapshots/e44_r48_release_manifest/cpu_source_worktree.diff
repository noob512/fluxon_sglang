+    match view
+        .external_client_api()
+        .inner()
+        .master_batch_gpu_get_done(transfer_get_ids)
+        .await
+    {
+        Ok(()) => ExternalGpuGetTerminal::Completed,
+        Err(err) => ExternalGpuGetTerminal::Failed {
